{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "noreviq/filament-theme",
    "description": "A focused teal and graphite theme for Filament 4 and 5 panels.",
    "keywords": [
        "filament",
        "filament-theme",
        "laravel",
        "panel",
        "theme"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Yousef Al-Jallad",
            "email": "eng.yousef.aljallad@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Noreviq\\FilamentTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noreviq\\FilamentTheme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "build-theme": "node bin/build.mjs",
        "format": "pint",
        "test": "phpunit",
        "verify-theme": "node bin/verify.mjs"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noreviq\\FilamentTheme\\NoreviqThemeServiceProvider"
            ]
        }
    }
}
